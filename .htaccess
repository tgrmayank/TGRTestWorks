# TGR TestWorks – Apache / cPanel / Hostinger
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType application/vnd.android.package-archive .apk
AddType application/manifest+json .webmanifest
AddType text/plain .txt
AddDefaultCharset UTF-8

<FilesMatch "\.apk$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment; filename=\"app.apk\""
    Header set X-Robots-Tag "noindex"
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# ---- Turn on AFTER your SSL certificate is active (remove the leading #) ----
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
